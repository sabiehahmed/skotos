{
  "name": "skotos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm run test:boundaries && pnpm -r --workspace-concurrency=1 test",
    "test:boundaries": "vitest run --config vitest.config.ts --maxWorkers=2",
    "test:ui": "pnpm --filter @skotos/ui test",
    "test:web": "pnpm --filter @skotos/web test",
    "test:api-client": "pnpm --filter @skotos/api-client test",
    "lint": "pnpm exec eslint --max-warnings 0 .",
    "lint:boundaries": "node scripts/check-ui-boundaries.mjs",
    "lint:md": "pnpm exec markdownlint-cli2 \"README.md\" \"docs/**/*.md\" \"design/**/*.md\" \"architecture/**/*.md\"",
    "format:check": "pnpm exec prettier --check \"README.md\" \"docs/**/*.md\" \"design/**/*.md\" \"architecture/**/*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
