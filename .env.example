# =============================================================================
# Skotos Local Development Environment Configuration
# Copy to .env and customize for local overrides: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose Local Infrastructure (deploy/docker/docker-compose.dev.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=skotos
POSTGRES_PASSWORD=skotos
POSTGRES_DB=skotos
POSTGRES_PORT=5432

NATS_PORT=4222
NATS_MONITOR_PORT=8222

# Note: MinIO enforces MINIO_ROOT_USER >= 3 chars and MINIO_ROOT_PASSWORD >= 8 chars
MINIO_ROOT_USER=skotos
MINIO_ROOT_PASSWORD=skotos-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Primary Datastore & Infrastructure Connections
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://skotos:skotos@localhost:5432/skotos
DATABASE_MAX_CONNECTIONS=20
SKOTOS_RUN_MIGRATIONS=true

# Phase 2+ delivery fanout & zero-egress R2/S3 snapshot storage (provisioned in Phase 1A)
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skotos-snapshots
S3_ACCESS_KEY_ID=skotos
S3_SECRET_ACCESS_KEY=skotos-dev-secret
S3_FORCE_PATH_STYLE=true

# Phase 4 optional ClickHouse columnar analytics backend (ADR-0005).
# Leave CLICKHOUSE_URL unset to use PostgreSQL analytics fallback automatically.
# Start locally with: docker compose -f deploy/docker/docker-compose.dev.yml --profile analytics up -d
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_DATABASE=skotos
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123

# -----------------------------------------------------------------------------
# Control Plane API (services/control-api)
# -----------------------------------------------------------------------------
SKOTOS_CONTROL_API_ADDR=0.0.0.0:8080
PORT=8080
RUST_LOG=info,control_api=debug,skotos_storage=info,sqlx=warn
SKOTOS_LOG_FORMAT=pretty

# Comma-separated explicit origins allowed with credentials (never "*" when cookies are enabled)
SKOTOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Flag Delivery Edge (services/delivery-edge — DB-free hot path)
# -----------------------------------------------------------------------------
SKOTOS_DELIVERY_EDGE_ADDR=0.0.0.0:8081
SKOTOS_SSE_KEEPALIVE_SECS=30

# -----------------------------------------------------------------------------
# Event Ingestion Service (services/event-ingest)
# -----------------------------------------------------------------------------
SKOTOS_EVENT_INGEST_ADDR=0.0.0.0:8082

# -----------------------------------------------------------------------------
# Open-Source Relay Proxy & MCP Server (services/relay-proxy, tools/skotos-mcp)
# -----------------------------------------------------------------------------
SKOTOS_RELAY_ADDR=0.0.0.0:8083
SKOTOS_MCP_ADDR=127.0.0.1:8084

# -----------------------------------------------------------------------------
# Authentication (crates/skotos-auth)
# Supported modes: self_hosted | external
# -----------------------------------------------------------------------------
SKOTOS_AUTH_MODE=self_hosted

# Required in self_hosted mode (minimum 32 bytes; MUST be replaced with a random secret in production)
SKOTOS_SESSION_SECRET=skotos-dev-session-secret-change-me-at-least-32-bytes
# Set to true behind HTTPS in production; false permits local HTTP http://localhost session cookies
SKOTOS_COOKIE_SECURE=false

# Idempotent bootstrap Owner account created on startup in self_hosted mode
SKOTOS_BOOTSTRAP_ORG_SLUG=default
SKOTOS_BOOTSTRAP_ORG_NAME="Skotos Local"
SKOTOS_BOOTSTRAP_ADMIN_EMAIL=admin@skotos.local
SKOTOS_BOOTSTRAP_ADMIN_PASSWORD=SkotosDevPass123!

# External Auth Provider (Cloud SaaS OIDC/JWT: WorkOS AuthKit, Auth0, Clerk)
# Uncomment and configure when SKOTOS_AUTH_MODE=external
# SKOTOS_OIDC_ISSUER=https://auth.example.com
# SKOTOS_OIDC_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# SKOTOS_OIDC_AUDIENCE=skotos-control-api
# SKOTOS_OIDC_CLIENT_ID=client_placeholder
# SKOTOS_OIDC_ORG_CLAIM=org_id

# -----------------------------------------------------------------------------
# Management Dashboard SPA (apps/web)
# -----------------------------------------------------------------------------
# Leave empty to use Vite's /api dev proxy (same-origin), or set e.g. http://localhost:8080 for direct CORS
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8080
